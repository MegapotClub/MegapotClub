{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["vite/client", "node"],
    "paths": {
      "club-test/coinbase-signer": [
        "./node_modules/@wagmi/connectors/node_modules/@coinbase/wallet-sdk/dist/sign/walletlink/WalletLinkSigner.d.ts"
      ]
    }
  },
  "include": ["src", "tests", "scripts/*.ts", "vite.config.ts"]
}
