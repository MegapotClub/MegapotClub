# No secrets or environment variables are required to build the static app.
# Browser RPC URLs are public configuration in public/config.json and src/config.ts.
# Optional local development host; leave unset for localhost.
# DEV_ALLOWED_HOST=preview.example.invalid
# Optional read-only contract tooling / fork test providers. Never use VITE_ for secrets.
# Set operator values in your shell; operator scripts do not load this file.
# CLUB_BASE_RPC=https://base-rpc.example.invalid/YOUR_KEY
# CLUB_ETHEREUM_RPC=https://ethereum-rpc.example.invalid/YOUR_KEY
# CLUB_FORK_BLOCK=YOUR_BLOCK_NUMBER
